{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Videonarez",
  "version": "0.2.5",
  "identifier": "com.videonarez.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Videonarez",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "shadow": true,
        "dragDropEnabled": true,
        "visible": false,
        "backgroundColor": "#1b1c1e",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --enable-features=PlatformHEVCDecoderSupport"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe"],
    "licenseFile": "../LICENSE",
    "resources": {
      "../LICENSE": "LICENSE.txt",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "copyright": "© 2026 INGSA1. Лицензия GPL-3.0-or-later."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMyMDU3NUNBN0YwMjIwRjQKUldUMElBSi95blVGd3ZHd0E0Z1RLSlZDK1pqSi9uVzhyYWFyeDZaSEZQM2w5MEFNWnFSWHNraU8K",
      "endpoints": ["https://84-201-181-80.sslip.io/videonarez/latest.json"],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
